<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pill_white"
    android:elevation="3dp"
    android:padding="12dp">

    <!-- Icon Container bên trái -->
    <FrameLayout
        android:id="@+id/layout_icon_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_pill_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_mission_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/bua" />
    </FrameLayout>

    <!-- Khối thông tin nhiệm vụ ở giữa -->
    <LinearLayout
        android:id="@+id/layout_mission_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_mission_action"
        app:layout_constraintStart_toEndOf="@id/layout_icon_container"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_mission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dũng sĩ đập chuột"
            android:textColor="#3E2723"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mission_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Đập trúng 10 chú chuột"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Thanh tiến trình nhiệm vụ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_mission"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1"
                android:max="10"
                android:progress="4"
                android:progressDrawable="@drawable/bg_progress_green" />

            <TextView
                android:id="@+id/tv_mission_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="4/10"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Khối thưởng và nút bấm bên phải -->
    <LinearLayout
        android:id="@+id/layout_mission_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Điểm thưởng sao -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/sao" />

            <TextView
                android:id="@+id/tv_mission_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 10 KN"
                android:textColor="#FF5722"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút bấm làm ngay / nhận quà -->
        <TextView
            android:id="@+id/btn_mission_action"
            android:layout_width="86dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_action_blue"
            android:gravity="center"
            android:text="Làm ngay"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
