<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nenchung">

    <!-- ================= THANH TRẠNG THÁI PHÍA TRÊN ================= -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:background="@android:color/transparent"
        android:contentDescription="Quay lại"
        android:scaleType="fitCenter"
        android:src="@drawable/thoat"
        app:layout_constraintBottom_toBottomOf="@id/layout_title_achievement"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_title_achievement" />

    <FrameLayout
        android:id="@+id/layout_title_achievement"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/khungtieude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Thành tích"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_score_box"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_pill_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@id/layout_title_achievement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_title_achievement">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Điểm KN"
            android:src="@drawable/sao" />

        <TextView
            android:id="@+id/tv_top_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120 KN"
            android:textColor="#B5214D"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ================= NỘI DUNG CUỘN ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_title_achievement">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- KHỐI HIỂN THỊ CẤP ĐỘ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_level_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_yellow"
                android:elevation="4dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Avatar"
                    android:src="@drawable/avatar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_level_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Cấp 1"
                    android:textColor="#B5214D"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/img_avatar"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/progress_level"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="8dp"
                    android:max="200"
                    android:progress="120"
                    android:progressDrawable="@drawable/bg_progress_orange"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_level_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_level_title" />

                <TextView
                    android:id="@+id/tv_level_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="120 / 200 KN"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/progress_level"
                    app:layout_constraintStart_toStartOf="@id/progress_level"
                    app:layout_constraintTop_toBottomOf="@id/progress_level" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BẢNG DANH HIỆU NỔI BẬT (CARD VÀNG NHẠT) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_card_yellow"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Tiêu đề nhỏ bên trong -->
                <LinearLayout
                    android:id="@+id/layout_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Star"
                        android:src="@drawable/sao" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thành tích nổi bật"
                        android:textColor="#B5214D"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- TextView hiển thị khi chưa có danh hiệu nào -->
                <TextView
                    android:id="@+id/tv_no_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="Chưa có danh hiệu nào"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <!-- Hàng 1: 3 Danh hiệu -->
                <LinearLayout
                    android:id="@+id/layout_badge_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Danh hiệu 1 -->
                    <LinearLayout
                        android:id="@+id/card_badge_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_badge_1"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Badge 1"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icondanhhieua" />

                        <TextView
                            android:id="@+id/tv_badge_1_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Dũng sĩ\ndiệt chuột"
                            android:textColor="#B5214D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_badge_1_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Đập trúng 100 chú\nchuột"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Danh hiệu 2 -->
                    <LinearLayout
                        android:id="@+id/card_badge_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_badge_2"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Badge 2"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icondanhhieub" />

                        <TextView
                            android:id="@+id/tv_badge_2_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Bàn tay\nkhéo léo"
                            android:textColor="#B5214D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_badge_2_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Hứng được 100 quả\nbóng"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Danh hiệu 3 -->
                    <LinearLayout
                        android:id="@+id/card_badge_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_badge_3"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Badge 3"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icondanhhieuc" />

                        <TextView
                            android:id="@+id/tv_badge_3_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Tay lái\ncừ khôi"
                            android:textColor="#B5214D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_badge_3_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Vượt qua 120 chặng\nđua"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hàng 2: 2 Danh hiệu (Căn giữa) -->
                <LinearLayout
                    android:id="@+id/layout_badge_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Danh hiệu 4 -->
                    <LinearLayout
                        android:id="@+id/card_badge_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_badge_4"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Badge 4"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icondanhhieud" />

                        <TextView
                            android:id="@+id/tv_badge_4_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Vua đập\nchuột"
                            android:textColor="#B5214D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_badge_4_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Đạt chuỗi 500\nđiểm"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Danh hiệu 5 -->
                    <LinearLayout
                        android:id="@+id/card_badge_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_badge_5"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="Badge 5"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icondanhhieue" />

                        <TextView
                            android:id="@+id/tv_badge_5_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Kỷ lục\nhứng bóng"
                            android:textColor="#B5214D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_badge_5_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Không bỏ sót\nquả nào"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Thống kê tổng quan dạng 4 ô hình chữ nhật bo góc bên dưới -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <!-- Ô 1: Chuột đã đập -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Búa"
                            android:src="@drawable/bua" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Số chuột đã đập"
                            android:textColor="#B5214D"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stat_mouse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="100"
                            android:textColor="#002171"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ô 2: Bóng đã hứng -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Bóng"
                            android:src="@drawable/iconbong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Số bóng đã hứng"
                            android:textColor="#B5214D"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stat_ball"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="110"
                            android:textColor="#002171"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ô 3: Chặng đã qua -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Đua xe"
                            android:src="@drawable/iconxe" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Số chặng đã qua"
                            android:textColor="#B5214D"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stat_car"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="120"
                            android:textColor="#002171"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ô 4: Khúc sông đã chèo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_card"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Thuyền"
                            android:src="@drawable/thuyen" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Số khúc sông\nđã chèo"
                            android:textColor="#B5214D"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stat_boat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="100"
                            android:textColor="#002171"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
