<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nenchung"> <!-- Nền xanh bầu trời -->

    <!-- Nút Thoát (Mũi tên cam) đồng bộ với các màn hình khác -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:background="@android:color/transparent"
        android:contentDescription="Quay lại"
        android:scaleType="fitCenter"
        android:src="@drawable/thoat"
        app:layout_constraintBottom_toBottomOf="@id/layout_title_task"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_title_task" />

    <!-- Khung tiêu đề "Nhiệm vụ" bằng khung gỗ đồng bộ kích thước/vị trí với màn hình Kết quả -->
    <FrameLayout
        android:id="@+id/layout_title_task"
        android:layout_width="170dp"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/khungtieude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nhiệm vụ"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Điểm kinh nghiệm góc phải top bar đồng bộ với màn hình Kết quả -->
    <LinearLayout
        android:id="@+id/layout_score_box"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_pill_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@id/layout_title_task"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_title_task">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Điểm KN"
            android:src="@drawable/sao" />

        <TextView
            android:id="@+id/tv_total_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 KN"
            android:textColor="#B5214D"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng chứa 2 Tab: Hôm nay & Tuần này -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_tab_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_title_task">

        <!-- Tab Hôm nay (chọn mặc định) -->
        <LinearLayout
            android:id="@+id/tab_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Hôm nay"
                android:src="@drawable/iconhomnay" />

            <TextView
                android:id="@+id/tv_tab_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hôm nay"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab Tuần này -->
        <LinearLayout
            android:id="@+id/tab_week"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Tuần này"
                android:src="@drawable/icontuannay" />

            <TextView
                android:id="@+id/tv_tab_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuần này"
                android:textColor="#0B1B72"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Danh sách nhiệm vụ (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_chest"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs" />

    <!-- Khối tiến trình mở rương phần thưởng dưới đáy -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_chest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_pill_white"
        android:elevation="4dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/img_chest"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Rương phần thưởng"
            android:scaleType="fitCenter"
            android:src="@drawable/iconruong"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_chest"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_chest_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hoàn thành 3 nhiệm vụ để mở rương phần thưởng!"
                android:textColor="#B5214D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Thanh tiến trình mở rương -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/progress_chest"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="3"
                    android:progress="2"
                    android:progressDrawable="@drawable/bg_progress_orange" />

                <TextView
                    android:id="@+id/tv_chest_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="2/3"
                    android:textColor="#3E2723"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
